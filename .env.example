# Copy to .env in the repository root. These are local defaults, not credentials.
CUSTOM_MODEL_PATH=models/CustomML/outputs/best.pt
AUTOML_TFLITE_PATH=models/AutoML/AutoML model.tflite
AUTOML_LABELS_PATH=models/AutoML/labels.txt
GC10_OUTPUT_DIR=models/GC10/releases/v1.0.0
MAX_UPLOAD_BYTES=5242880
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
LOG_LEVEL=INFO
ASSISTANT_MODE=local
ENABLE_VERTEX_AI=false
GCP_PROJECT_ID=
GCP_REGION=us-central1
VERTEX_AI_AUTOML_ENDPOINT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# Optional cloud-training overrides; leave unset for local training.
AIP_MODEL_DIR=
TRAIN_BATCH_SIZE=
TRAIN_NUM_WORKERS=
# Only VITE_* values are exposed to the browser. Never put secrets here.
VITE_API_BASE_URL=http://localhost:8001
VITE_DEMO_MODE=false
VITE_DEMO_EMPLOYEE_USER=
VITE_DEMO_EMPLOYEE_PASSWORD=
VITE_DEMO_ADMIN_USER=
VITE_DEMO_ADMIN_PASSWORD=
